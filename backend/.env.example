# --- LLM ---
# Leave empty to run on the mock analysis. A non-empty value here with
# USE_MOCK_LLM=false is what switches Gemini on.
GOOGLE_API_KEY=
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.6-flash

# --- Supabase Auth ---
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Database ---
# Local dev (SQLite):
DATABASE_URL=sqlite:///./vacancyscore.db
# Supabase: Dashboard > Connect > Transaction pooler. URL-encode special
# characters in the password and keep sslmode=require. Plain postgresql:// is
# accepted and automatically upgraded to the psycopg 3 driver.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require

# --- CORS (comma separated) ---
ALLOWED_ORIGINS=http://localhost:3000
# Public frontend used in password-recovery emails. In production, set this to
# the canonical Vercel URL and add the same /reset-password URL in Supabase.
PUBLIC_APP_URL=http://localhost:3000

# --- Runtime ---
ENVIRONMENT=dev
PORT=8000

# --- Abuse protection ---
ANALYZE_DAILY_LIMIT=10
MAX_CVS_PER_USER=10
MAX_VACANCY_CHARS=15000
MAX_UPLOAD_BYTES=5242880

# --- Mock switch ---
# true  = fixture analysis + deterministic hashing embedder (no downloads, no key)
# false = real bge-small embeddings, and real Gemini if GOOGLE_API_KEY is set
USE_MOCK_LLM=false
