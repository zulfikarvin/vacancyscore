# Local development uses http://localhost:8000 automatically.
# Uncomment only if your local backend runs somewhere else:
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Vercel: set this server-only variable to the deployed backend project.
# Next.js proxies /api requests there, keeping browser auth cookies first-party.
BACKEND_API_URL=https://your-backend-project.vercel.app
